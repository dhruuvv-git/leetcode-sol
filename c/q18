    int b=nums[0];
    for(int i=0;i<numsSize;i++){
        if(nums[i]>a){
            a=nums[i];
        }
        if(nums[i]<b){
            b=nums[i];
        }
    }
    int i=b;
    int res=1;
    while(i>0){
        if((a%i==0)&&(b%i==0)){
            return i;
        }
        i--;

    }
    return 1;

    
}