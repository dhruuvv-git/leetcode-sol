/*
=== PROBLEM ===
Input: x = 121
Output: true
Explanation: 121 reads as 121 from left to right and from right to left.
*/

bool isPalindrome(int x) {
    if (x<0){
        return false;
    }
    int y =x;
    int count=0;
    while(y>0){
        y=y/10;
        count++;
    }
    if(count<=1){
        return true;
    }
    int a[count];
    int b[count];
    for(int i=0;i<count;i++){
        int k = x%10;
        a[i]=k;
        b[count-1-i]=k;
        x=x/10;
    }
    int z=0;
    for(int i=0;i<count;i++){
        if(a[i]==a[count-1-i]){
            continue;
        }
        else{
            z++;
        }
    }
        if(z==0){
            return true;
        }
        else{
            return false;
        }
}
        
    