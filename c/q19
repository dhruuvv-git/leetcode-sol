/*
=== PROBLEM ===
Input: n = 99

Output: true

Explanation:

Since 99 is divisible by the sum (9 + 9 = 18) plus product (9 * 9 = 81) of its digits (total 99), the output is true.
*/

bool checkDivisibility(int n) {
    int a=n;
    int sum=0;
    int product=1;
    while(a>0){
        int b=a%10;
        sum+=b;
        product*=b;
        a=a/10;

    }
    int c=sum+product;
    if(n%c==0){
        return true;
    }
    else{
        return false;
    }
    
}