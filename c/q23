/*
=== PROBLEM ===
Input: digits = [1,2,3]
Output: [1,2,4]
Explanation: The array represents the integer 123.
Incrementing by one gives 123 + 1 = 124.
Thus, the result should be [1,2,4].
*/

int* plusOne(int* arr, int size, int* returnSize) {

    int* result = (int*)malloc((size + 1) * sizeof(int));
    
    int carry = 1; 
    for (int i = size - 1; i >= 0; i--) {
        int sum = arr[i] + carry;
        result[i + 1] = sum % 10;
        carry = sum / 10;
    }
    
  
    if (carry) {
        result[0] = carry;
        *returnSize = size + 1;
        return result; 
    } else {
        *returnSize = size;
        return result + 1; 
    }
}