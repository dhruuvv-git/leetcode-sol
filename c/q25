/*
=== PROBLEM ===
Example 1:

Input: nums = [1,3,2]

Output: 2

Explanation:

For nums[2] = 2, the sum of digits is 2, which is equal to index i = 2. Thus, the output is 2.
*/

int smallestIndex(int* nums, int numsSize) {
    int i=0;
    while(i<numsSize){
        int j= nums[i];
        int sum=0;
        while(j>0){
            int x= j%10;
            sum+=x;
            j=j/10;
        }
        if(sum==i){
            return sum;
        }
        i++;
    }
    return -1;
    
}