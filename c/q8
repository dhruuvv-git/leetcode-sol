/*
=== PROBLEM ===
Input: n = 2
Output: 2
Explanation: There are two ways to climb to the top.
1. 1 step + 1 step
2. 2 steps
*/

int climbStairs(int n) {
    if(n<=1){
        return 1;
    }
    int a = 1;
    int b = 1;
    int c;
    for(int i=2;i<=n;i++){
        c = a+b;
        b = a;
        a = c;
    }
    return c;
}