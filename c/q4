/*
=== PROBLEM ===
Example 1:

Input: x = 4
Output: 2
Explanation: The square root of 4 is 2, so we return 2.
*/

int mySqrt(int x) {
    if (x == 0 || x == 1) {
        return x;
    }

    int start = 1;
    int end = x;
    int ans = 0;

    while (start <= end) {
        int mid = start + (end - start) / 2;
        long long square = (long long)mid * mid;

        if (square == x) {
            return mid;
        } else if (square < x) {
            ans = mid;     // mid is a valid candidate (mid^2 < x), save it
            start = mid + 1; // look for a larger valid integer
        } else {
            end = mid - 1;   // mid^2 > x, search lower half
        }
    }

    return ans; // returns floor(sqrt(x))
}