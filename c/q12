/*
=== PROBLEM ===
Example 1:

Input: n = 27
Output: true
Explanation: 27 = 33
*/

bool isPowerOfThree(int n) {
    if(n<=0){
        return false;
    }
    else{
        while(n%3==0){
            n=n/3;
        }
        if(n==1){
            return true;
        }
        else{
            return false;
        }
    }
}