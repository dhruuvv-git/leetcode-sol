/*
=== PROBLEM ===
Input: head = [1,2,6,3,4,5,6], val = 6
Output: [1,2,3,4,5]
*/

struct ListNode* removeElements(struct ListNode* head, int val) {
while (head != NULL && head->val == val) {
        struct ListNode* temp = head;
        head = head->next;
        
    }

   
    if (head == NULL) {
        return NULL;
    }

   
    struct ListNode* k = head;
    struct ListNode* p = head->next;

    
    while (p != NULL) {
        if (p->val == val) {
            k->next = p->next;  
            p = p->next;        
        } else {
            k = p;              
            p = p->next;
        }
    }

    return head;
}