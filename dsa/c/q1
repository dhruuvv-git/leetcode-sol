/*
=== PROBLEM ===
Given a string s containing just the characters '(', ')', '{', '}', '[' and ']', determine if the input string is valid.

An input string is valid if:

Open brackets must be closed by the same type of brackets.
Open brackets must be closed in the correct order.
Every close bracket has a corresponding open bracket of the same type.
*/

#include <stdio.h>
#include <string.h>
int match(char a,char b){
    if((a=='(')&&(b==')')){
        return 1;
    }
    else if((a=='{')&&(b=='}')){
        return 1;
    }
    else if((a=='[')&&(b==']')){
        return 1;
    }
    else{
        return 0;
    }
}
bool isValid(char* s){
    int a = strlen(s);
    int top=-1;
    char b[a];
    for(int i=0;s[i]!='\0';i++){
        if((s[i]=='(')||(s[i]=='[')||(s[i]=='{')){
            top++;
            b[top]=s[i];
        }
        else if((s[i]==')')||(s[i]=='}')||(s[i]==']')){
            if(top==-1){
                return false;
            }
            else{
                char val = b[top];
                top--;
                int d = match(val,s[i]);
                if(d==1){
                    continue;
                }
                else{
                    return false;
                }
            }
        }
    }
    if(top==-1){
        return true;
    }
    else{
        return false;
    }

}
  