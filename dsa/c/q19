/*
=== PROBLEM ===
Input: root = [3,9,20,null,null,15,7]
Output: 3
Example 2:

Input: root = [1,null,2]
Output: 2
*/

int maxDepth(struct TreeNode* root) {
    if(root==NULL){
        return 0;
    }
    int maxleft=maxDepth(root->left);
    int maxright=maxDepth(root->right);
    return fmax(maxleft,maxright)+1;
    
}