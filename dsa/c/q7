/*
=== PROBLEM ===
Input: head = [1,2,3,4,5,6]
Output: [4,5,6]
Explanation: Since the list has two middle nodes with values 3 and 4, we return the second one.
*/

struct ListNode* middleNode(struct ListNode* head) {
    struct ListNode* temp=head;
    int count=0;
    while(temp!='\0'){
        temp=temp->next;
        count++;
    }
    temp=head;
    int mid=count/2;
    for(int i=0;i<mid;i++){
        temp=temp->next;
    }
    return temp;
    
}