/*
=== PROBLEM ===
Example 1:

Input: s = "abc"

Output: "abc"

Explanation:

There is no digit in the string.

Example 2:

Input: s = "cb34"

Output: ""

Explanation:

First, we apply the operation on s[2], and s becomes "c4".
*/

char* clearDigits(char* s) {
    int len = strlen(s), top = -1;
    char* stack = (char*)malloc(len + 1);
    for (int i = 0; i < len; i++) {
        if (isdigit(s[i])) {
            if (top >= 0){
             top--;
            }
        } 
        else {
            top++;
            stack[top] = s[i];
        }
    }
    top++;
    stack[top] = '\0';
    return stack;
}