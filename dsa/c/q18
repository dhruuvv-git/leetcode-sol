/*
=== PROBLEM ===
Input: root = [1,null,2,3]

Output: [1,3,2]
*/

int i=0;
int a[100];
void Traversal(struct TreeNode* root) {
    if(root==NULL){
        return;
    }
    Traversal(root->left);
    a[i]=root->val;
    i++;
    Traversal(root->right);    
}
int* inorderTraversal(struct TreeNode* root, int* returnSize) {
    i=0;
    Traversal(root);
    *returnSize=i;
    return a;
}