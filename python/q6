/*
=== PROBLEM ===
Input: s = "()(())((()()))"

Output: 3
*/

class Solution(object):
    def maxDepth(self, s):
        d = 0
        ans = 0

        for a in s:
            if a == '(':
                d += 1
                ans = max(ans, d)
            elif a == ')':
                d -= 1

        return ans