/*
=== PROBLEM ===
Example 1:

Input: strs = ["flower","flow","flight"]
Output: "fl"
Example 2:

Input: strs = ["dog","racecar","car"]
Output: ""
Explanation: There is no common prefix among the input strings.
*/

class Solution(object):
    def longestCommonPrefix(self, strs):
        if not strs:
            return ""

       
        strs.sort()

        first = strs[0]
        last = strs[-1]
        prefix = ""

       
        for i in range(len(first)):
            if first[i] == last[i]:
                prefix += first[i]
            else:
                break 
        return prefix